  langid = {english},
  keywords = {Mathematics and computing,Social sciences},
  file = {C:\Users\luehrija\Zotero\storage\LFW4KZAE\Avalle et al. - 2024 - Persistent interaction patterns across social medi.pdf}
}

@article{badenMeaningMultiplicityValid2023,
  title = {Meaning Multiplicity and Valid Disagreement in Textual Measurement: {{A}} Plea for a Revised Notion of Reliability},
  shorttitle = {Meaning Multiplicity and Valid Disagreement in Textual Measurement},
  author = {Baden, Christian and {Boxman-Shabtai}, Lillian and {Tenenboim-Weinblatt}, Keren and Overbeck, Maximilian and Aharoni, Tali},
  year = 2023,
  journal = {Studies in Communication and Media},
  volume = {12},
