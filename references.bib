@article{pfefferThisSampleSeems2023,
  title = {This {{Sample Seems}} to {{Be Good Enough}}! {{Assessing Coverage}} and {{Temporal Reliability}} of {{Twitter}}'s {{Academic API}}},
  author = {Pfeffer, J{\"u}rgen and Mooseder, Angelina and Lasser, Jana and Hammer, Luca and Stritzel, Oliver and Garcia, David},
